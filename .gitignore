# Runtime outputs: keep only the small example sample
output/*
!output/example/
*/output/

# Python runtime artifacts
__pycache__/
*.pyc

# Module virtualenvs / caches
**/.venv/
**/TMP/

# AmC raw run data (re-fetchable — see calibsel/PROVENANCE.amc.md §3 and
# calibsel/input/amc_data/MANIFEST.sha256 for checksums + fetch commands)
calibsel/input/amc_data/*.npz
